{
  "$schema": "https://opencode.ai/config.json",

  "small_model": "opencode-go/mimo-v2.5",

  "mcp": {
    "linear": {
      "type": "remote",
      "url": "https://mcp.linear.app/mcp",
      "oauth": {}
    }
  },

  "agent": {
    "spec-drafter": {
      "model": "opencode-go/mimo-v2.5-pro"
    },
    "plan-synthesizer": {
      "model": "opencode-go/mimo-v2.5-pro"
    },
    "slice-planner": {
      "model": "opencode-go/mimo-v2.5-pro"
    },
    "design-drafter": {
      "model": "opencode-go/mimo-v2.5-pro"
    },
    "doc-syncer": {
      "model": "opencode-go/mimo-v2.5-pro"
    },

    "design-verifier": {
      "model": "opencode-go/qwen3.7-plus"
    },
    "code-verifier": {
      "model": "opencode-go/qwen3.7-plus"
    },
    "doc-sync-verifier": {
      "model": "opencode-go/qwen3.7-plus"
    },

    "technical-design": {
      "model": "opencode-go/mimo-v2.5"
    },
    "plan-project": {
      "model": "opencode-go/mimo-v2.5"
    },
    "implement-project": {
      "model": "opencode-go/mimo-v2.5"
    },
    "design-scout": {
      "model": "opencode-go/mimo-v2.5"
    },
    "repo-scout": {
      "model": "opencode-go/mimo-v2.5"
    },
    "scope-resolver": {
      "model": "opencode-go/mimo-v2.5"
    },
    "issue-writer": {
      "model": "opencode-go/mimo-v2.5"
    },
    "repo-ops": {
      "model": "opencode-go/mimo-v2.5"
    },

    "build": {
      "mode": "all",
      "model": "opencode-go/qwen3.7-plus",
      "steps": 15
    },
    "plan": {
      "model": "opencode-go/qwen3.7-plus",
      "mode": "all"
    }
  }
}
